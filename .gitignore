## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options
.vs/

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# DotNet CLI
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# IIS Express
.vs/config/
applicationhost.config

# Azure
PublishScripts/

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Coverlet / code coverage
coverage/
coverage*.json
coverage*.xml
*.coverage
*.coveragexml

# BenchmarkDotNet
BenchmarkDotNet.Artifacts/

# Entity Framework
*.mdf
*.ldf

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# npm / frontend
node_modules/
dist/
build/

# Environment files
.env
.env.*

# Secrets
secrets.json

# Docker
docker-compose.override.yml

# Generated files
Generated/
wwwroot/lib/

# Publish output
publish/

# JetBrains Rider
.idea/

# Local history
.localhistory/

# Paket
.paket/
paket-files/

# Cake
tools/**
!tools/packages.config

# FAKE
.fake/

# Ionide
.ionide/

# Backup & temp files
*.bak
*.tmp
*.temp
*.swp